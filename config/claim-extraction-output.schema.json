{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["assertions", "coverage_gaps"],
  "properties": {
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assertion_code", "source_passage_ref", "assertion_type", "subject", "predicate", "object", "time_expression", "location_expression", "qualifiers", "polarity", "source_attribution", "confidence", "ambiguity_flags", "passage_support"],
        "properties": {
          "assertion_code": {"type": "string", "minLength": 1},
          "source_passage_ref": {"type": "string", "minLength": 1},
          "assertion_type": {"enum": ["event_fact", "identity_fact", "role_fact", "outcome_fact", "causal_claim", "historiographical_evaluation", "numeric_fact", "context_fact"]},
          "subject": {"type": "string", "minLength": 1},
          "predicate": {"type": "string", "minLength": 1},
          "object": {"type": "string", "minLength": 1},
          "time_expression": {"type": ["string", "null"]},
          "location_expression": {"type": ["string", "null"]},
          "qualifiers": {"type": "object", "additionalProperties": false, "properties": {}},
          "polarity": {"enum": ["asserted", "disputed", "negated"]},
          "source_attribution": {"type": "object", "additionalProperties": false, "properties": {}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "ambiguity_flags": {"type": "array", "items": {"type": "string"}},
          "passage_support": {
            "type": "object",
            "additionalProperties": false,
            "required": ["support_mode", "assertion_semantic_key", "supported_fields"],
            "properties": {
              "support_mode": {"enum": ["single_passage", "equivalent_evidence", "atomic_component", "context_only"]},
              "assertion_semantic_key": {"type": "string", "minLength": 1},
              "supported_fields": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"enum": ["identity", "action", "responsibility", "time", "location", "outcome", "consequence", "attribution", "context"]}
              }
            }
          }
        }
      }
    },
    "coverage_gaps": {"type": "array", "items": {"type": "string"}}
  }
}
