{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["assertions", "coverage_gaps"],
  "properties": {
    "assertions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_passage_ref",
          "assertion_type",
          "subject",
          "predicate",
          "object",
          "time_expression",
          "location_expression",
          "qualifiers",
          "polarity",
          "source_attribution",
          "confidence",
          "ambiguity_flags",
          "passage_support"
        ],
        "properties": {
          "source_passage_ref": {
            "type": "string",
            "minLength": 1
          },
          "assertion_type": {
            "type": "string",
            "enum": [
              "event_fact",
              "identity_fact",
              "role_fact",
              "outcome_fact",
              "causal_claim",
              "historiographical_evaluation",
              "numeric_fact",
              "context_fact"
            ]
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "predicate": {
            "type": "string",
            "minLength": 1
          },
          "object": {
            "type": "string",
            "minLength": 1
          },
          "time_expression": {
            "type": ["string", "null"]
          },
          "location_expression": {
            "type": ["string", "null"]
          },
          "qualifiers": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "responsibility_family",
              "office_or_domain",
              "outcome",
              "cost_or_damage",
              "focal_person_ref",
              "candidate_focal_person_refs",
              "event_scope",
              "normalized_time"
            ],
            "properties": {
              "responsibility_family": {
                "type": ["string", "null"]
              },
              "office_or_domain": {
                "type": ["string", "null"]
              },
              "outcome": {
                "type": ["string", "null"]
              },
              "cost_or_damage": {
                "type": ["string", "null"]
              },
              "focal_person_ref": {
                "type": ["string", "null"]
              },
              "candidate_focal_person_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "event_scope": {
                "type": ["string", "null"]
              },
              "normalized_time": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "required": [
                  "start_sort_key",
                  "end_sort_key",
                  "precision",
                  "dynasty_or_era"
                ],
                "properties": {
                  "start_sort_key": {
                    "type": ["integer", "string", "null"]
                  },
                  "end_sort_key": {
                    "type": ["integer", "string", "null"]
                  },
                  "precision": {
                    "type": ["string", "null"]
                  },
                  "dynasty_or_era": {
                    "type": ["string", "null"]
                  }
                }
              }
            }
          },
          "polarity": {
            "type": "string",
            "enum": ["asserted", "disputed", "negated"]
          },
          "source_attribution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "attribution_type",
              "speaker",
              "work",
              "quoted_text"
            ],
            "properties": {
              "attribution_type": {
                "type": ["string", "null"]
              },
              "speaker": {
                "type": ["string", "null"]
              },
              "work": {
                "type": ["string", "null"]
              },
              "quoted_text": {
                "type": ["string", "null"]
              }
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "ambiguity_flags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "passage_support": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "support_mode",
              "assertion_semantic_key",
              "supported_fields"
            ],
            "properties": {
              "support_mode": {
                "type": "string",
                "enum": [
                  "single_passage",
                  "equivalent_evidence",
                  "atomic_component",
                  "context_only"
                ]
              },
              "assertion_semantic_key": {
                "type": "string",
                "minLength": 1
              },
              "supported_fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "enum": [
                    "identity",
                    "action",
                    "responsibility",
                    "time",
                    "location",
                    "outcome",
                    "consequence",
                    "attribution",
                    "context"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "coverage_gaps": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
