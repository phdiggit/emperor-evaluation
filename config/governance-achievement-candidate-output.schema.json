{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "governance-achievement-candidate-output.schema.json",
  "title": "V4 Governance Achievement Candidate Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_code", "component_decisions", "achievements", "limitations"],
  "properties": {
    "schema_version": {"type": "string", "const": "governance-achievement-candidate-output-v2"},
    "task_code": {"type": "string", "minLength": 1},
    "component_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_ref", "disposition", "reason"],
        "properties": {
          "component_ref": {"type": "string", "minLength": 1},
          "disposition": {"type": "string", "enum": ["register", "omit", "uncertain"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "local_key", "independent_governance_key", "canonical_label", "domain",
          "component_refs", "period_start", "period_end", "implementation_status",
          "observable_result", "result_direction", "positive_result_preserved", "value_judgment",
          "scale_level", "scale_basis", "scale_reason", "foundational",
          "durable_cross_stage", "stable_delivery", "important_method_or_legacy",
          "participants", "limitations"
        ],
        "properties": {
          "local_key": {"type": "string", "pattern": "^achievement-[1-9][0-9]*$"},
          "independent_governance_key": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "canonical_label": {"type": "string", "minLength": 1},
          "domain": {
            "type": "string",
            "enum": [
              "central_institutions", "law_and_adjudication", "official_selection",
              "fiscal_taxation", "local_government", "economy_production",
              "infrastructure_public_works", "education_talent", "other_governance"
            ]
          },
          "component_refs": {
            "type": "array", "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "period_start": {"type": "string"},
          "period_end": {"type": "string"},
          "implementation_status": {
            "type": "string",
            "enum": ["implemented", "operated", "completed", "mixed", "failed", "unclear"]
          },
          "observable_result": {"type": "string", "minLength": 1},
          "result_direction": {"type": "string", "enum": ["positive", "mixed", "negative", "unclear"]},
          "positive_result_preserved": {"type": "boolean"},
          "value_judgment": {"type": "object"},
          "scale_level": {"type": "string", "enum": ["local", "important", "regional", "national", "era_shaping"]},
          "scale_basis": {
            "type": "string",
            "enum": [
              "local_public_result", "important_public_result", "regional_governance_result",
              "national_core_subsystem", "national_public_result", "era_order_reconstruction"
            ]
          },
          "scale_reason": {"type": "string", "minLength": 1},
          "foundational": {"type": "boolean"},
          "durable_cross_stage": {"type": "boolean"},
          "stable_delivery": {"type": "boolean"},
          "important_method_or_legacy": {"type": "boolean"},
          "participants": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["person_ref", "responsibility_role", "contribution_scope", "contribution_types", "contribution_basis_fact_refs"],
              "properties": {
                "person_ref": {"type": "string", "minLength": 1},
                "responsibility_role": {"type": "string", "enum": ["exclusive", "lead", "participant"]},
                "contribution_scope": {"type": "string", "minLength": 1},
                "contribution_types": {
                  "type": "array", "minItems": 1,
                  "items": {"type": "string", "enum": ["policy_design", "institutional_design", "implementation_lead", "operational_delivery", "corrective_oversight", "authorization", "scholarly_authorship", "general_participation"]}
                },
                "contribution_basis_fact_refs": {
                  "type": "array",
                  "items": {"type": "string", "minLength": 1}
                }
              }
            }
          },
          "limitations": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
