{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_code",
    "dynasty",
    "source_chars",
    "chains",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "dynasty-neutral-governance-output-v1"
    },
    "task_code": {"type": "string", "minLength": 1},
    "dynasty": {"type": "string", "minLength": 1},
    "source_chars": {"type": "integer", "minimum": 1},
    "chains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chain_key",
          "title",
          "domain",
          "period",
          "action",
          "implementation",
          "observable_result",
          "cost_or_burden",
          "affected_groups",
          "operation_status",
          "temporal_scope",
          "geographic_scope",
          "actors",
          "evidence",
          "uncertainty"
        ],
        "properties": {
          "chain_key": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "domain": {
            "type": "string",
            "enum": [
              "central_government",
              "local_government",
              "official_selection",
              "official_discipline",
              "supervision_feedback",
              "law_and_adjudication",
              "fiscal_taxation",
              "economy_production",
              "livelihood_social_order",
              "military_system",
              "military_logistics",
              "frontier_administration",
              "education_talent",
              "culture_knowledge",
              "ritual_identity_integration",
              "infrastructure_public_works",
              "succession_resilience",
              "other_governance"
            ]
          },
          "period": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "implementation": {"type": "string"},
          "observable_result": {"type": "string"},
          "cost_or_burden": {"type": "string"},
          "affected_groups": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "operation_status": {
            "type": "string",
            "enum": [
              "proposed",
              "ordered",
              "enacted",
              "implemented",
              "operated",
              "modified",
              "repealed",
              "completed",
              "observed_outcome",
              "mixed_chain",
              "unclear"
            ]
          },
          "temporal_scope": {
            "type": "string",
            "enum": [
              "single_event",
              "repeated_pattern",
              "long_term_pattern",
              "cross_reign_continuity",
              "cross_dynastic_continuity",
              "unclear"
            ]
          },
          "geographic_scope": {
            "type": "string",
            "enum": [
              "court",
              "local",
              "regional",
              "national",
              "frontier",
              "multi_region",
              "unclear"
            ]
          },
          "actors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "responsibility_role",
                "contribution_phases",
                "role_basis",
                "quote_refs"
              ],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "responsibility_role": {
                  "type": "string",
                  "enum": ["exclusive", "lead", "participant"]
                },
                "contribution_phases": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "enum": [
                      "initiated",
                      "designed",
                      "authorized",
                      "implemented",
                      "operated",
                      "corrected",
                      "repealed",
                      "reported_or_evaluated"
                    ]
                  }
                },
                "role_basis": {"type": "string", "minLength": 1},
                "quote_refs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string", "minLength": 1}
                }
              }
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "quote_ref",
                "page_title",
                "revision_ref",
                "exact_quote"
              ],
              "properties": {
                "quote_ref": {"type": "string", "minLength": 1},
                "page_title": {"type": "string", "minLength": 1},
                "revision_ref": {"type": "string", "minLength": 1},
                "exact_quote": {"type": "string", "minLength": 1}
              }
            }
          },
          "uncertainty": {"type": "string"}
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
