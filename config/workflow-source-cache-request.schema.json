{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow-source-cache-request-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "collection_id", "works"],
  "properties": {
    "schema_version": {"const": "workflow-source-cache-request-v1"},
    "request_id": {"type": "string", "minLength": 1},
    "collection_id": {"type": "string", "minLength": 1},
    "dynasty": {"type": "string"},
    "works": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["work_title"],
        "properties": {
          "work_title": {"type": "string", "minLength": 1},
          "root_title": {"type": "string", "minLength": 1},
          "required_page_titles": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "required_page_ranges": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["page_title_format", "first", "last"],
              "properties": {
                "page_title_format": {"type": "string", "minLength": 1},
                "first": {"type": "integer", "minimum": 1},
                "last": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    }
  }
}
