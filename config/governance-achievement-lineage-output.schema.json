{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "governance-achievement-lineage-output.schema.json",
  "title": "V4 Governance Achievement Lineage Refinement Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_code", "selections", "limitations"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "governance-achievement-lineage-output-v1"
    },
    "task_code": {"type": "string", "minLength": 1},
    "selections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["achievement_ref", "fact_refs", "unsupported_component_refs", "reason"],
        "properties": {
          "achievement_ref": {"type": "string", "minLength": 1},
          "fact_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "unsupported_component_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
