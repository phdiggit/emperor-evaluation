{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campaign-registry.schema.json",
  "title": "V4 Neutral Campaign Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_version",
    "status",
    "campaigns"
  ],
  "properties": {
    "schema_version": {
      "const": "campaign-registry-v1"
    },
    "registry_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["shadow", "human_frozen"]
    },
    "campaigns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/campaign"
      }
    }
  },
  "$defs": {
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_ref",
        "independent_campaign_key",
        "canonical_label",
        "episode_refs",
        "period",
        "theater",
        "strategic_objective",
        "outcome",
        "campaign_tier",
        "campaign_tier_basis",
        "land_strategic_value",
        "strategic_result_class",
        "combat_difficulty",
        "combat_difficulty_basis",
        "scale",
        "participants",
        "source_refs",
        "reuse_targets"
      ],
      "properties": {
        "campaign_ref": {"type": "string", "pattern": "^CAM-[A-Z0-9-]+$"},
        "independent_campaign_key": {"type": "string", "minLength": 1},
        "canonical_label": {"type": "string", "minLength": 1},
        "episode_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "period": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {"type": "string"},
            "end": {"type": "string"}
          }
        },
        "theater": {"type": "string", "minLength": 1},
        "strategic_objective": {"type": "string", "minLength": 1},
        "campaign_tier": {"enum": ["C", "B", "A", "S-", "S", "S+"]},
        "campaign_tier_basis": {"type": "string", "minLength": 1},
        "strategic_result_class": {"enum": ["local_tactical", "important_objective", "major_stage_or_crisis", "independent_direction", "external_hegemony_decisive_defeat", "single_pole_or_state_terminal", "composite_poles_terminal", "unification_terminal", "external_hegemony_terminal"]},
        "combat_difficulty": {"enum": ["D0", "D1", "D2", "D3", "D4"]},
        "combat_difficulty_basis": {"type": "string", "minLength": 1},
        "land_strategic_value": {
          "enum": ["local_point", "important_region", "strategic_gateway", "core_heartland", "capital_or_state_survival"]
        },
        "opponent_force_effect": {
          "enum": ["none", "limited_attrition", "major_degradation", "main_force_destroyed", "military_system_collapsed"]
        },
        "outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": ["battle_result", "objective_completion", "observable_consequence"],
          "properties": {
            "battle_result": {"enum": ["victory", "mixed", "defeat", "unclear"]},
            "objective_completion": {"enum": ["complete", "partial", "failed", "unclear"]},
            "observable_consequence": {"type": "string", "minLength": 1}
          }
        },
        "scale": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "consequence_basis", "decisiveness", "opponent_condition", "opponent_strategic_weight", "reason"],
          "properties": {
            "level": {"enum": ["local", "important", "regional", "national", "era_shaping"]},
            "consequence_basis": {
              "enum": [
                "local_tactical",
                "important_objective",
                "regional_theater_control",
                "national_war_outcome",
                "state_survival",
                "unification",
                "state_conquest",
                "era_order_reconstruction"
              ]
            },
            "decisiveness": {"enum": ["supporting", "major", "decisive"]},
            "opponent_condition": {"enum": ["strong", "viable", "weakened", "residual", "unclear"]},
            "opponent_strategic_weight": {"enum": ["minor", "regional_major", "first_tier_pole", "dominant_pole", "external_state", "external_hegemony", "unclear"]},
            "reason": {"type": "string", "minLength": 1}
          }
        },
        "participants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["person_ref", "command_role", "command_scope"],
            "properties": {
              "person_ref": {"type": "string", "minLength": 1},
              "command_role": {"enum": ["commander_in_chief", "principal_commander", "participant"]},
              "command_scope": {"type": "string", "minLength": 1}
            }
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "reuse_targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "talent_grade_military",
              "item1_c1_campaign_contribution",
              "item1_c2_frontline_command",
              "item3_military_security"
            ]
          }
        }
      }
    }
  }
}
