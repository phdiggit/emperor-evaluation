{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "coverage_complete": {"type": "boolean"},
    "coverage_gaps": {"items": {"type": "string"}, "type": "array"},
    "object_ref": {"minLength": 1, "type": "string"},
    "observations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "authorization_key": {"type": ["string", "null"]},
          "disposition": {
            "enum": ["counted", "supporting", "excluded"],
            "type": "string"
          },
          "effect_support": {
            "enum": ["positive", "negative", "neutral", "not_established"],
            "type": "string"
          },
          "fact": {"minLength": 1, "type": "string"},
          "observation_code": {"minLength": 1, "type": "string"},
          "observation_type": {
            "enum": ["authorization", "operation", "result", "policy_advice"],
            "type": "string"
          },
          "reason": {"minLength": 1, "type": "string"},
          "source_chunk_refs": {
            "items": {"minLength": 1, "type": "string"},
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "observation_code",
          "observation_type",
          "authorization_key",
          "effect_support",
          "fact",
          "source_chunk_refs",
          "disposition",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "task_code": {"minLength": 1, "type": "string"}
  },
  "required": [
    "task_code",
    "object_ref",
    "coverage_complete",
    "coverage_gaps",
    "observations"
  ],
  "type": "object"
}
