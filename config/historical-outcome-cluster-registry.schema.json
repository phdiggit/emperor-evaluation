{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "historical-outcome-cluster-registry.schema.json",
  "title": "V4 Current Neutral Historical Outcome Cluster Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "clusters"],
  "properties": {
    "schema_version": {"const": "historical-outcome-cluster-registry-v3"},
    "status": {"enum": ["shadow", "human_frozen"]},
    "clusters": {
      "type": "array",
      "items": {"$ref": "#/$defs/cluster"}
    }
  },
  "$defs": {
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "minLength": 1},
        "end": {"type": "string", "minLength": 1}
      }
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "consequence_basis", "decisiveness", "reason"],
      "properties": {
        "level": {"enum": ["local", "important", "regional", "national", "era_shaping"]},
        "consequence_basis": {
          "enum": [
            "local_tactical", "important_objective", "regional_theater_control",
            "national_war_outcome", "state_survival", "unification", "state_conquest",
            "local_public_result", "important_public_result", "regional_governance_result",
            "national_core_subsystem", "national_public_result", "national_cultural_corpus", "era_order_reconstruction", "civilization_foundational_corpus"
          ]
        },
        "decisiveness": {"enum": ["supporting", "major", "decisive"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_ref", "actor_name", "actor_kind", "role_code", "contribution_scope"],
      "properties": {
        "actor_ref": {"type": "string", "minLength": 1},
        "actor_name": {"type": "string", "minLength": 1},
        "actor_kind": {"enum": ["person", "ruler"]},
        "role_code": {
          "enum": [
            "commander_in_chief", "principal_commander", "participant", "not_in_command_chain",
            "exclusive", "lead", "governance_participant", "authorized", "reign_holder"
          ]
        },
        "talent_credit": {
          "enum": ["independent", "covered_by_child", "not_applicable"]
        },
        "sovereign_at_event": {"type": "boolean"},
        "ruler_campaign_relation": {
          "enum": [
            "authorization_only", "operational_direction", "frontline_command"
          ]
        },
        "authorization_mode": {"enum": ["explicit", "tacit"]},
        "control_extent": {"enum": ["partial", "sustained"]},
        "obstruction_status": {"enum": ["none", "confirmed"]},
        "contribution_scope": {"type": "string", "minLength": 1},
        "contribution_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "policy_design", "institutional_design", "implementation_lead",
              "operational_delivery", "corrective_oversight", "authorization",
              "scholarly_authorship", "general_participation"
            ]
          }
        },
        "contribution_basis_fact_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "delegated_responsibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope", "importance_basis", "basis", "authorization_refs"
          ],
          "properties": {
            "authorizer_ref": {"type": "string", "minLength": 1},
            "scope": {
              "enum": [
                "nominal_or_light", "real_bounded", "major_affairs",
                "critical_national_or_long_term"
              ]
            },
            "appointment_effect": {
              "enum": [
                "weak_feedback", "normal_success", "major_success",
                "exceptional_success"
              ]
            },
            "continuity_factor": {
              "enum": [
                "short_or_one_off", "stable", "long_term_multi_stage"
              ]
            },
            "importance_basis": {"type": "string", "minLength": 1},
            "basis": {"type": "string", "minLength": 1},
            "authorization_refs": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "campaign_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theater", "strategic_objective", "battle_result", "objective_completion",
        "opponent_condition", "opponent_strategic_weight", "strategic_result_class",
        "campaign_tier", "campaign_tier_basis", "land_strategic_value",
        "strategic_stakes", "prewar_context", "failure_stakes",
        "combat_difficulty", "combat_difficulty_basis", "operational_costs",
        "objective_shortfalls", "attributable_failures"
      ],
      "properties": {
        "theater": {"type": "string", "minLength": 1},
        "strategic_objective": {"type": "string", "minLength": 1},
        "battle_result": {"enum": ["victory", "mixed", "defeat", "unclear"]},
        "objective_completion": {"enum": ["complete", "partial", "failed", "unclear"]},
        "opponent_condition": {"enum": ["strong", "viable", "weakened", "residual", "unclear"]},
        "opponent_strategic_weight": {"enum": ["minor", "regional_major", "first_tier_pole", "dominant_pole", "external_state", "external_hegemony", "unclear"]},
        "strategic_result_class": {"enum": ["local_tactical", "important_objective", "major_stage_or_crisis", "independent_direction", "single_pole_or_state_terminal", "composite_poles_terminal", "unification_terminal", "external_hegemony_terminal"]},
        "campaign_tier": {"enum": ["C", "B", "A", "S-", "S", "S+"]},
        "campaign_tier_basis": {"type": "string", "minLength": 1},
        "land_strategic_value": {
          "enum": ["local_point", "important_region", "strategic_gateway", "core_heartland", "capital_or_state_survival"]
        },
        "strategic_stakes": {
          "enum": ["bounded", "major", "critical", "existential"]
        },
        "prewar_context": {"type": "string", "minLength": 1},
        "failure_stakes": {"type": "string", "minLength": 1},
        "combat_difficulty": {"enum": ["D0", "D1", "D2", "D3"]},
        "combat_difficulty_basis": {"type": "string", "minLength": 1},
        "operational_costs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["basis", "source_refs"],
            "properties": {
              "basis": {"type": "string", "minLength": 1},
              "source_refs": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "objective_shortfalls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["basis", "source_refs"],
            "properties": {
              "basis": {"type": "string", "minLength": 1},
              "source_refs": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "attributable_failures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["responsibility", "severity_index", "actor_ref", "actor_name", "basis", "source_refs"],
            "properties": {
              "responsibility": {
                "enum": ["primary", "shared", "subordinate_execution", "disobedience", "mitigated", "not_responsible"]
              },
              "severity_index": {"enum": [0.2, 0.4, 0.6, 0.7, 1]},
              "actor_ref": {"type": "string", "minLength": 1},
              "actor_name": {"type": "string", "minLength": 1},
              "basis": {"type": "string", "minLength": 1},
              "source_refs": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "governance_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "foundational", "durable_cross_stage", "authorization_status", "causal_attribution_status"],
      "properties": {
        "domain": {
          "enum": [
            "central_institutions", "law_and_adjudication", "official_selection",
            "fiscal_taxation", "local_government", "economy_production",
            "infrastructure_public_works", "education_talent", "strategic_coordination",
            "crisis_management", "culture_scholarship", "other_governance"
          ]
        },
        "foundational": {"type": "boolean"},
        "durable_cross_stage": {"type": "boolean"},
        "authorization_status": {"enum": ["explicit", "maintained", "implicit", "not_established"]},
        "causal_attribution_status": {"enum": ["established", "source_attributed", "limited"]},
        "value_judgment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "comparison_basis", "baseline_fact_refs", "overall_direction",
            "overall_magnitude", "axes", "effect_horizon", "basis"
          ],
          "properties": {
            "comparison_basis": {"enum": ["explicit_before_after", "prior_institution_comparison", "public_effect_without_explicit_baseline", "not_established"]},
            "baseline_fact_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "overall_direction": {"enum": ["positive", "mixed", "negative", "unclear"]},
            "overall_magnitude": {"enum": ["limited", "significant", "structural", "era_shaping", "not_established"]},
            "axes": {
              "type": "object",
              "additionalProperties": false,
              "required": ["productivity_livelihood", "civilization_institutions", "state_people_security", "culture_education_thought"],
              "properties": {
                "productivity_livelihood": {"$ref": "#/$defs/value_axis"},
                "civilization_institutions": {"$ref": "#/$defs/value_axis"},
                "state_people_security": {"$ref": "#/$defs/value_axis"},
                "culture_education_thought": {"$ref": "#/$defs/value_axis"}
              }
            },
            "effect_horizon": {"enum": ["short", "medium", "long", "cross_stage", "unclear"]},
            "basis": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "value_axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "magnitude", "basis_fact_refs", "basis"],
      "properties": {
        "direction": {"enum": ["positive", "negative", "mixed", "not_established"]},
        "magnitude": {"enum": ["limited", "significant", "structural", "era_shaping", "not_established"]},
        "basis_fact_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "basis": {"type": "string"}
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_ref", "outcome_kind", "independent_key", "canonical_label", "origin",
        "period", "result_status", "result_direction", "observable_result", "scale",
        "stable_delivery", "important_method_or_legacy", "episode_refs", "fact_refs",
        "source_refs", "evidence_lineage", "members", "limitations", "payload", "ruler_window_status",
        "settlement_scope",
        "semantic_fingerprint"
      ],
      "properties": {
        "outcome_ref": {"type": "string", "pattern": "^OUTCOME-[A-Z0-9-]+$"},
        "outcome_kind": {"enum": ["campaign", "governance", "statecraft"]},
        "settlement_scope": {
          "enum": ["war_terminal_context", "ruler_campaign_parent", "person_campaign_subresult", "governance_result", "person_governance_result", "reign_macro_outcome", "person_statecraft_result"]
        },
        "parent_outcome_ref": {"type": "string", "pattern": "^OUTCOME-[A-Z0-9-]+$"},
        "independent_key": {"type": "string", "minLength": 1},
        "canonical_label": {"type": "string", "minLength": 1},
        "origin": {"enum": ["person_biography", "ruler_chronicle", "dynasty_governance", "multi_channel"]},
        "period": {"$ref": "#/$defs/period"},
        "result_status": {"enum": ["implemented", "operated", "completed", "mixed", "failed", "unclear"]},
        "result_direction": {"enum": ["positive", "mixed", "negative", "unclear"]},
        "observable_result": {"type": "string", "minLength": 1},
        "scale": {"$ref": "#/$defs/scale"},
        "stable_delivery": {"type": "boolean"},
        "important_method_or_legacy": {"type": "boolean"},
        "episode_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^EP-OUTCOME-[A-Z0-9-]+$"}
        },
        "ruler_context_refs": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "ruler_window_status": {
          "enum": ["within_window", "leadership_formation", "outside_window", "unresolved"]
        },
        "fact_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "evidence_lineage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fact_ref", "evidence_roles"],
            "properties": {
              "fact_ref": {"type": "string", "minLength": 1},
              "evidence_roles": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "historical_baseline", "measure_or_design",
                    "implementation_or_operation", "public_result",
                    "public_cost_or_harm", "continuity_or_reversal",
                    "responsibility_or_attribution"
                  ]
                }
              }
            }
          }
        },
        "members": {"type": "array", "items": {"$ref": "#/$defs/member"}},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "payload": {
          "oneOf": [
            {"$ref": "#/$defs/campaign_payload"},
            {"$ref": "#/$defs/governance_payload"}
          ]
        },
        "semantic_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
