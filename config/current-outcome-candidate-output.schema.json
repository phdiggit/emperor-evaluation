{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_code", "candidates", "rejections"],
  "properties": {
    "schema_version": {"type": "string", "const": "current-outcome-candidate-output-v2"},
    "task_code": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_key", "canonical_label", "source_page", "revision_ref",
          "exact_quotes", "neutral_summary", "period_start", "period_end", "origin",
          "outcome_kind", "result_status", "result_direction", "observable_result",
          "scale_level", "scale_basis", "decisiveness", "scale_reason",
          "stable_delivery", "important_method_or_legacy", "ruler_window_status",
          "settlement_scope", "members", "payload", "limitations"
        ],
        "properties": {
          "candidate_key": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "canonical_label": {"type": "string", "minLength": 1},
          "source_page": {"type": "string", "minLength": 1},
          "revision_ref": {"type": "string", "minLength": 1},
          "exact_quotes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
          "neutral_summary": {"type": "string", "minLength": 1},
          "period_start": {"type": "string", "minLength": 1},
          "period_end": {"type": "string", "minLength": 1},
          "origin": {"type": "string", "enum": ["person_biography", "ruler_chronicle", "dynasty_governance", "multi_channel"]},
          "outcome_kind": {"type": "string", "enum": ["campaign", "governance", "statecraft"]},
          "settlement_scope": {"type": "string", "enum": ["war_terminal_context", "ruler_campaign_parent", "person_campaign_subresult", "governance_result", "person_governance_result", "reign_macro_outcome", "person_statecraft_result"]},
          "parent_outcome_ref": {"type": ["string", "null"]},
          "result_status": {"type": "string", "enum": ["implemented", "operated", "completed", "mixed", "failed", "unclear"]},
          "result_direction": {"type": "string", "enum": ["positive", "mixed", "negative", "unclear"]},
          "observable_result": {"type": "string", "minLength": 1},
          "scale_level": {"type": "string", "enum": ["local", "important", "regional", "national", "era_shaping"]},
          "scale_basis": {"type": "string", "enum": ["local_tactical", "important_objective", "regional_theater_control", "national_war_outcome", "state_survival", "unification", "state_conquest", "local_public_result", "important_public_result", "regional_governance_result", "national_core_subsystem", "national_public_result", "national_cultural_corpus", "era_order_reconstruction", "civilization_foundational_corpus"]},
          "decisiveness": {"type": "string", "enum": ["supporting", "major", "decisive"]},
          "scale_reason": {"type": "string", "minLength": 1},
          "stable_delivery": {"type": "boolean"},
          "important_method_or_legacy": {"type": "boolean"},
          "ruler_window_status": {"type": "string", "enum": ["within_window", "leadership_formation", "outside_window", "unresolved"]},
          "members": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["actor_name", "actor_kind", "role_code", "contribution_scope", "responsibility_scope", "authorization_quotes"],
              "properties": {
                "actor_name": {"type": "string", "minLength": 1},
                "actor_kind": {"type": "string", "enum": ["person", "ruler"]},
                "role_code": {"type": "string", "enum": ["commander_in_chief", "principal_commander", "participant", "not_in_command_chain", "exclusive", "lead", "governance_participant", "authorized", "reign_holder"]},
                "talent_credit": {"type": "string", "enum": ["independent", "covered_by_child", "not_applicable"]},
                "sovereign_at_event": {"type": ["boolean", "null"]},
                "ruler_campaign_relation": {"type": ["string", "null"], "enum": ["authorization_only", "operational_direction", "frontline_command", null]},
                "authorization_mode": {"type": ["string", "null"], "enum": ["explicit", "tacit", null]},
                "control_extent": {"type": ["string", "null"], "enum": ["partial", "sustained", null]},
                "obstruction_status": {"type": ["string", "null"], "enum": ["none", "confirmed", null]},
                "contribution_scope": {"type": "string", "minLength": 1},
                "responsibility_scope": {"type": "string", "enum": ["nominal_or_light", "real_bounded", "major_affairs", "critical_national_or_long_term", "not_applicable"]},
                "authorization_quotes": {"type": "array", "items": {"type": "string", "minLength": 2}}
              }
            }
          },
          "payload": {
            "type": "object", "additionalProperties": false,
            "required": [
              "domain", "foundational", "durable_cross_stage", "authorization_status",
              "theater", "strategic_objective", "battle_result", "objective_completion",
              "opponent_condition", "opponent_strategic_weight", "strategic_result_class",
              "combat_difficulty", "combat_difficulty_basis"
            ],
            "properties": {
              "domain": {"type": ["string", "null"], "enum": ["central_institutions", "law_and_adjudication", "official_selection", "fiscal_taxation", "local_government", "economy_production", "infrastructure_public_works", "education_talent", "strategic_coordination", "crisis_management", "culture_scholarship", "other_governance", null]},
              "foundational": {"type": ["boolean", "null"]},
              "durable_cross_stage": {"type": ["boolean", "null"]},
              "authorization_status": {"type": ["string", "null"], "enum": ["explicit", "maintained", "implicit", "not_established", null]},
              "causal_attribution_status": {"type": ["string", "null"], "enum": ["established", "source_attributed", "limited", null]},
              "value_judgment": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "required": [
                  "overall_direction", "productivity_effect", "civilization_effect",
                  "social_cost", "effect_horizon", "basis"
                ],
                "properties": {
                  "overall_direction": {"type": "string", "enum": ["positive", "mixed", "negative", "unclear"]},
                  "productivity_effect": {"type": "string", "enum": ["beneficial", "adverse", "mixed", "not_established"]},
                  "civilization_effect": {"type": "string", "enum": ["beneficial", "adverse", "mixed", "not_established"]},
                  "social_cost": {"type": "string", "enum": ["beneficial", "limited", "material", "severe", "not_established"]},
                  "effect_horizon": {"type": "string", "enum": ["short", "medium", "long", "cross_stage", "unclear"]},
                  "basis": {"type": "string", "minLength": 1}
                }
              },
              "theater": {"type": ["string", "null"]},
              "strategic_objective": {"type": ["string", "null"]},
              "battle_result": {"type": ["string", "null"], "enum": ["victory", "mixed", "defeat", "unclear", null]},
              "objective_completion": {"type": ["string", "null"], "enum": ["complete", "partial", "failed", "unclear", null]},
              "opponent_condition": {"type": ["string", "null"], "enum": ["strong", "viable", "weakened", "residual", "unclear", null]},
              "opponent_strategic_weight": {"type": ["string", "null"], "enum": ["minor", "regional_major", "first_tier_pole", "dominant_pole", "external_state", "external_hegemony", "unclear", null]},
              "strategic_result_class": {"type": ["string", "null"], "enum": ["local_tactical", "important_objective", "major_stage_or_crisis", "independent_direction", "single_pole_or_state_terminal", "composite_poles_terminal", "unification_terminal", "external_hegemony_terminal", null]},
              "campaign_tier": {"type": ["string", "null"], "enum": ["C", "B", "A", "S-", "S", "S+", null]},
              "campaign_tier_basis": {"type": ["string", "null"]},
              "land_strategic_value": {"type": ["string", "null"], "enum": ["local_point", "important_region", "strategic_gateway", "core_heartland", "capital_or_state_survival", null]},
              "strategic_stakes": {"type": ["string", "null"], "enum": ["bounded", "major", "critical", "existential", null]},
              "prewar_context": {"type": ["string", "null"]},
              "failure_stakes": {"type": ["string", "null"]},
              "combat_difficulty": {"type": ["string", "null"], "enum": ["D0", "D1", "D2", "D3", null]},
              "combat_difficulty_basis": {"type": ["string", "null"]},
              "operational_costs": {
                "type": ["array", "null"],
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["basis", "exact_quotes"],
                  "properties": {
                    "basis": {"type": "string", "minLength": 1},
                    "exact_quotes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}}
                  }
                }
              },
              "objective_shortfalls": {
                "type": ["array", "null"],
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["basis", "exact_quotes"],
                  "properties": {
                    "basis": {"type": "string", "minLength": 1},
                    "exact_quotes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}}
                  }
                }
              },
              "attributable_failures": {
                "type": ["array", "null"],
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["responsibility", "severity_index", "actor_name", "basis", "exact_quotes"],
                  "properties": {
                    "responsibility": {"type": "string", "enum": ["primary", "shared", "subordinate_execution", "disobedience", "mitigated", "not_responsible"]},
                    "severity_index": {"type": "number", "enum": [0.2, 0.4, 0.6, 0.7, 1]},
                    "actor_name": {"type": "string", "minLength": 1},
                    "basis": {"type": "string", "minLength": 1},
                    "exact_quotes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}}
                  }
                }
              }
            }
          },
          "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "allOf": [
          {
            "if": {"properties": {"outcome_kind": {"const": "campaign"}}},
            "then": {
              "properties": {
                "payload": {
                  "required": ["campaign_tier", "campaign_tier_basis", "land_strategic_value", "strategic_stakes", "prewar_context", "failure_stakes", "strategic_result_class", "combat_difficulty", "combat_difficulty_basis", "operational_costs", "objective_shortfalls", "attributable_failures"],
                  "properties": {
                    "campaign_tier": {"type": "string"},
                    "campaign_tier_basis": {"type": "string", "minLength": 1},
                    "land_strategic_value": {"type": "string"},
                    "strategic_stakes": {"type": "string"},
                    "prewar_context": {"type": "string", "minLength": 1},
                    "failure_stakes": {"type": "string", "minLength": 1},
                    "strategic_result_class": {"type": "string"},
                    "combat_difficulty": {"type": "string"},
                    "combat_difficulty_basis": {"type": "string", "minLength": 1},
                    "operational_costs": {"type": "array"},
                    "objective_shortfalls": {"type": "array"},
                    "attributable_failures": {"type": "array"}
                  }
                }
              }
            }
          },
          {
            "if": {"properties": {"outcome_kind": {"const": "governance"}}},
            "then": {
              "properties": {
                "payload": {
                  "required": ["value_judgment"],
                  "properties": {
                    "domain": {"type": "string"},
                    "foundational": {"type": "boolean"},
                    "durable_cross_stage": {"type": "boolean"},
                    "authorization_status": {"type": "string"},
                    "causal_attribution_status": {"type": "string"},
                    "value_judgment": {"type": "object"}
                  }
                }
              }
            }
          },
          {
            "if": {"properties": {"outcome_kind": {"const": "statecraft"}}},
            "then": {
              "properties": {
                "payload": {
                  "properties": {
                    "domain": {"type": "string"},
                    "foundational": {"type": "boolean"},
                    "durable_cross_stage": {"type": "boolean"},
                    "authorization_status": {"type": "string"},
                    "causal_attribution_status": {"type": "string"}
                  }
                }
              }
            }
          }
        ]
      }
    },
    "rejections": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["segment_ref", "reason"],
        "properties": {
          "segment_ref": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
