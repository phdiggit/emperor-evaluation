{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_code", "candidates", "rejections"],
  "properties": {
    "schema_version": {"type": "string", "const": "current-outcome-candidate-output-v1"},
    "task_code": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_key", "canonical_label", "source_page", "revision_ref",
          "exact_quotes", "neutral_summary", "period_start", "period_end", "origin",
          "outcome_kind", "result_status", "result_direction", "observable_result",
          "scale_level", "scale_basis", "decisiveness", "scale_reason",
          "stable_delivery", "important_method_or_legacy", "ruler_window_status",
          "members", "payload", "limitations"
        ],
        "properties": {
          "candidate_key": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "canonical_label": {"type": "string", "minLength": 1},
          "source_page": {"type": "string", "minLength": 1},
          "revision_ref": {"type": "string", "minLength": 1},
          "exact_quotes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
          "neutral_summary": {"type": "string", "minLength": 1},
          "period_start": {"type": "string", "minLength": 1},
          "period_end": {"type": "string", "minLength": 1},
          "origin": {"type": "string", "enum": ["person_biography", "ruler_chronicle", "dynasty_governance", "multi_channel"]},
          "outcome_kind": {"type": "string", "enum": ["campaign", "governance"]},
          "result_status": {"type": "string", "enum": ["implemented", "operated", "completed", "mixed", "failed", "unclear"]},
          "result_direction": {"type": "string", "enum": ["positive", "mixed", "negative", "unclear"]},
          "observable_result": {"type": "string", "minLength": 1},
          "scale_level": {"type": "string", "enum": ["local", "important", "regional", "national", "era_shaping"]},
          "scale_basis": {"type": "string", "enum": ["local_tactical", "important_objective", "regional_theater_control", "national_war_outcome", "state_survival", "unification", "state_conquest", "local_public_result", "important_public_result", "regional_governance_result", "national_core_subsystem", "national_public_result", "era_order_reconstruction"]},
          "decisiveness": {"type": "string", "enum": ["supporting", "major", "decisive"]},
          "scale_reason": {"type": "string", "minLength": 1},
          "stable_delivery": {"type": "boolean"},
          "important_method_or_legacy": {"type": "boolean"},
          "ruler_window_status": {"type": "string", "enum": ["within_window", "leadership_formation", "outside_window", "unresolved"]},
          "members": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["actor_name", "actor_kind", "role_code", "contribution_scope", "responsibility_scope", "authorization_quotes"],
              "properties": {
                "actor_name": {"type": "string", "minLength": 1},
                "actor_kind": {"type": "string", "enum": ["person", "ruler"]},
                "role_code": {"type": "string", "enum": ["commander_in_chief", "principal_commander", "deputy_commander", "participant", "not_in_command_chain", "exclusive", "lead", "governance_participant", "authorized"]},
                "ruler_campaign_relation": {"type": ["string", "null"], "enum": ["obstructed", "acquiesced", "authorized", "temporary_theater_control", "sustained_theater_control", "personal_command", null]},
                "contribution_scope": {"type": "string", "minLength": 1},
                "responsibility_scope": {"type": "string", "enum": ["nominal_or_light", "real_bounded", "major_affairs", "critical_national_or_long_term", "not_applicable"]},
                "authorization_quotes": {"type": "array", "items": {"type": "string", "minLength": 2}}
              }
            }
          },
          "payload": {
            "type": "object", "additionalProperties": false,
            "required": [
              "domain", "foundational", "durable_cross_stage", "authorization_status",
              "theater", "strategic_objective", "battle_result", "objective_completion",
              "opponent_condition", "opponent_strategic_weight"
            ],
            "properties": {
              "domain": {"type": ["string", "null"], "enum": ["central_institutions", "law_and_adjudication", "official_selection", "fiscal_taxation", "local_government", "economy_production", "infrastructure_public_works", "education_talent", "strategic_coordination", "crisis_management", "culture_scholarship", "other_governance", null]},
              "foundational": {"type": ["boolean", "null"]},
              "durable_cross_stage": {"type": ["boolean", "null"]},
              "authorization_status": {"type": ["string", "null"], "enum": ["explicit", "maintained", "implicit", "not_established", null]},
              "theater": {"type": ["string", "null"]},
              "strategic_objective": {"type": ["string", "null"]},
              "battle_result": {"type": ["string", "null"], "enum": ["victory", "mixed", "defeat", "unclear", null]},
              "objective_completion": {"type": ["string", "null"], "enum": ["complete", "partial", "failed", "unclear", null]},
              "opponent_condition": {"type": ["string", "null"], "enum": ["strong", "viable", "weakened", "residual", "unclear", null]},
              "opponent_strategic_weight": {"type": ["string", "null"], "enum": ["minor", "regional_major", "national_peer", "imperial_main_force", "unclear", null]},
              "campaign_tier": {"type": ["string", "null"], "enum": ["C", "B", "A", "S-", "S", "S+", null]},
              "campaign_tier_basis": {"type": ["string", "null"]},
              "land_strategic_value": {"type": ["string", "null"], "enum": ["local_point", "important_region", "strategic_gateway", "core_heartland", "capital_or_state_survival", null]},
              "process_adversity": {"type": ["string", "null"], "enum": ["none", "limited", "material", "severe_repaired", "near_collapse_repaired", "terminal_failure", null]},
              "process_adversity_basis": {"type": ["string", "null"]}
            }
          },
          "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "allOf": [
          {
            "if": {"properties": {"outcome_kind": {"const": "campaign"}}},
            "then": {
              "properties": {
                "ruler_window_status": {
                  "enum": ["within_window", "leadership_formation", "outside_window"]
                },
                "payload": {
                  "properties": {
                    "campaign_tier": {"type": "string"},
                    "campaign_tier_basis": {"type": "string", "minLength": 1},
                    "land_strategic_value": {"type": "string"},
                    "process_adversity": {"type": "string"},
                    "process_adversity_basis": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          },
          {
            "if": {"properties": {"outcome_kind": {"const": "governance"}}},
            "then": {
              "properties": {
                "payload": {
                  "properties": {
                    "domain": {"type": "string"},
                    "foundational": {"type": "boolean"},
                    "durable_cross_stage": {"type": "boolean"},
                    "authorization_status": {"type": "string"}
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "outcome_kind": {"const": "campaign"},
                "ruler_window_status": {
                  "enum": ["within_window", "leadership_formation"]
                }
              },
              "required": ["outcome_kind", "ruler_window_status"]
            },
            "then": {
              "properties": {
                "members": {
                  "contains": {
                    "type": "object",
                    "required": ["actor_kind", "ruler_campaign_relation"],
                    "properties": {
                      "actor_kind": {"const": "ruler"},
                      "ruler_campaign_relation": {"type": "string"}
                    }
                  },
                  "minContains": 1,
                  "maxContains": 1
                }
              }
            }
          }
        ]
      }
    },
    "rejections": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["segment_ref", "reason"],
        "properties": {
          "segment_ref": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
