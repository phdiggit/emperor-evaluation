# Local PostgreSQL development DSN. Copy to .env and fill locally.
EMPEROR_EVAL_PG_DSN=postgresql://USER:PASSWORD@HOST:5432/emperor_eval_dev

# Optional legacy/benchmark-specific alias. Prefer EMPEROR_EVAL_PG_DSN going forward.
PG_SEARCH_BENCH_DSN=postgresql://USER:PASSWORD@HOST:5432/emperor_eval_dev
