    {
      "context_kind": "episode",
      "context_summary": "sealed 表达安全与因果边界",
      "evidence": [
        {
          "assertion_ref": "EVD-I5B-LIUXIU-NEG-HUANTAN-001@A1",
          "quote": "譚復極言讖之非經。帝大怒曰：桓譚非聖無法，將下斬之。",
