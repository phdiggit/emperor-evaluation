            "v3_freeze_tag": "v3-freeze-20260712",
            "v3_source_blob": "aee5cc390ad9c903b3b97e0e0edba516e66e5476"
          },
          "summary": "张释之能在皇帝不满时坚持专业法理并被采纳，显示刘恒保留专业官僚反馈入口和容谏空间。"
        }
      ],
      "ruler": "刘恒",
      "subject": "张释之",
      "unit_ref": "TT-S01"
    },
    {
      "context_kind": "episode",
      "context_summary": "sealed 表达安全与因果边界",
      "evidence": [
        {
          "assertion_ref": "EVD-I5B-YANGJIAN-POS-SUWEI-RONGJIAN-001@A1",
          "quote": "威入閤進諫，不納。上怒甚……良久，乃召威謝曰：「公能若是，吾無憂矣。」",
          "source": {
            "formal_v4_fact": false,
            "lineage_kind": "readonly_v3_regression_candidate",
            "locator": "列传第六，高颎、苏威传，高颎委以心膂及苏威进谏段",
            "source_ref": "SRC-SS-J41-GAOJIONG-SUWEI-YANGJIAN-001",
            "source_title": "隋书",
            "url": "https://zh.wikisource.org/wiki/%E9%9A%8B%E6%9B%B8/%E5%8D%B741",
            "v3_card_blob": "7f00f0bc227807b385319dea3faab2fc638dbd39",
            "v3_freeze_tag": "v3-freeze-20260712",
            "v3_source_blob": "aee5cc390ad9c903b3b97e0e0edba516e66e5476"
          },
          "summary": "苏威强谏阻杀并获杨坚事后致谢，能够支撑开皇前期臣下反馈入口和容谏空间。"
        }
      ],
      "ruler": "杨坚",
      "subject": "苏威",
      "unit_ref": "TT-S02"
    },
    {
      "context_kind": "episode",
      "context_summary": "sealed 表达安全与因果边界",
      "evidence": [
        {
          "assertion_ref": "EVD-I5B-LIZHI-POS-LAIJI-001@A1",
          "quote": "来济谏曰：山东役丁岁别数万……臣愿初成役者留之，馀悉免遣。上从之。",
          "source": {
            "formal_v4_fact": false,
            "lineage_kind": "readonly_v3_regression_candidate",
            "locator": "唐纪十六，来济请省山东役丁，高宗从之段",
            "source_ref": "SRC-ZZTJ-J200-LAIJI-LIZHI-001",
            "source_title": "资治通鉴",
            "url": "https://zh.wikisource.org/zh-hans/資治通鑑/卷200",
            "v3_card_blob": "7f00f0bc227807b385319dea3faab2fc638dbd39",
            "v3_freeze_tag": "v3-freeze-20260712",
            "v3_source_blob": "aee5cc390ad9c903b3b97e0e0edba516e66e5476"
          },
          "summary": "李治采纳来济减役谏议，构成第五项B容谏反馈和专业建议采纳强正候选。"
        }
      ],
      "ruler": "李治",
      "subject": "来济",
      "unit_ref": "TT-S03"
    },
    {
      "context_kind": "episode",
      "context_summary": "sealed 表达安全与因果边界",
      "evidence": [
