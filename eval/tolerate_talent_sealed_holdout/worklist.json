      "evidence": [
        {
          "assertion_ref": "EVD-I5B-LIUHENG-POS-ZHANGSHIZHI-RONGJIAN-001@A1",
          "quote": "廷尉，天下之平也……今法如是，更重之，是法不信於民也。",
          "source": {
            "formal_v4_fact": false,
            "lineage_kind": "readonly_v3_regression_candidate",
            "locator": "张释之冯唐列传，张释之执法进谏段",
