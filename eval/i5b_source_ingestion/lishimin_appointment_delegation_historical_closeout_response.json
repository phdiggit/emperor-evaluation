    {
      "content_hash": "9b0c591727609630eced29847ce456e76f54cbf58e9e65a387b9b5e577953552",
      "content_version": "revision:2610556:b656305b592199375be2bb95200b19a36b64f0f3ac78c0b2388ea46c20e582ab",
      "context_after": "",
      "context_before": "",
      "document_id": "SCD-1A4F3BD77EBB8119479A",
      "linked_passages": [],
      "locator": "jiutangshu-69-houjunji-authorization:49-557",
