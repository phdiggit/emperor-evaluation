  "tasks": [
    {
      "context_kind": "rule_evidence_unit",
      "context_summary": "appointment_delegation 代表性缺口增补",
      "coverage_tags": [
        "absence_sensitive"
      ],
      "evidence": [
        {
          "assertion_ref": "EVD-I5B-WUZETIAN-POS-LIZHAODE-001@A1",
          "quote": "吾任昭德，始得安眠，此代吾劳，汝勿言也。",
          "source": {
            "formal_v4_fact": false,
            "lineage_kind": "readonly_v3_regression_candidate",
            "locator": "唐纪二十一，武则天任李昭德分劳并回应谏言段",
            "source_ref": "SRC-ZZTJ-J205-LIZHAODE-WUZETIAN-001",
            "source_title": "资治通鉴",
            "url": "https://zh.wikisource.org/zh-hans/資治通鑑/卷205",
            "v3_card_blob": "7f00f0bc227807b385319dea3faab2fc638dbd39",
            "v3_freeze_tag": "v3-freeze-20260712",
            "v3_source_blob": "aee5cc390ad9c903b3b97e0e0edba516e66e5476"
          },
          "summary": "武则天对李昭德的明确信任显示其有任用能臣分担政务的正向能力，可作强正候选。"
        }
      ],
      "ruler": "武曌",
      "subject": "李昭德",
      "unit_ref": "AD-G01"
    },
    {
      "context_kind": "rule_evidence_unit",
      "context_summary": "appointment_delegation 代表性缺口增补",
      "coverage_tags": [
        "short_or_one_off"
      ],
      "evidence": [
        {
          "assertion_ref": "EVD-I5B-LICHUN-POS-PEIDU-001@A1",
          "quote": "上方委裴度以用兵；裴度曰……上从之。",
          "source": {
            "formal_v4_fact": false,
            "lineage_kind": "readonly_v3_regression_candidate",
            "locator": "唐纪五十，宪宗委裴度用兵及采纳魏博渡河议段",
            "source_ref": "SRC-ZZTJ-J240-PEIDU-LICHUN-001",
            "source_title": "资治通鉴",
            "url": "https://zh.wikisource.org/zh-hans/資治通鑑/卷240",
            "v3_card_blob": "7f00f0bc227807b385319dea3faab2fc638dbd39",
            "v3_freeze_tag": "v3-freeze-20260712",
            "v3_source_blob": "aee5cc390ad9c903b3b97e0e0edba516e66e5476"
          },
          "summary": "李纯委裴度用兵并采纳其战区判断，构成第五项B授权专任和专业反馈强正候选。"
        }
      ],
      "ruler": "李纯",
      "subject": "裴度",
      "unit_ref": "AD-G02"
    },
    {
      "context_kind": "rule_evidence_unit",
      "context_summary": "appointment_delegation 代表性缺口增补",
      "coverage_tags": [
        "multi_source_join"
      ],
      "evidence": [
        {
          "assertion_ref": "EVD-I5B-LIYUAN-POS-LIUWENJING-001@A1",
          "quote": "渊从之。处罗可汗命特勒康鞘利等送马千匹，又以兵五百人随文静而至。",
          "source": {
            "formal_v4_fact": false,
            "lineage_kind": "readonly_v3_regression_candidate",
            "locator": "隋纪八，刘文静劝结突厥、受命请兵及李渊称将命之功段",
            "source_ref": "SRC-ZZTJ-J184-LIUWENJING-LIYUAN-001",
            "source_title": "资治通鉴",
            "url": "https://zh.wikisource.org/zh-hans/資治通鑑/卷184",
            "v3_card_blob": "7f00f0bc227807b385319dea3faab2fc638dbd39",
            "v3_freeze_tag": "v3-freeze-20260712",
            "v3_source_blob": "aee5cc390ad9c903b3b97e0e0edba516e66e5476"
          },
          "summary": "李渊采用刘文静谋议并委其执行外援沟通，构成创业期谋士使用和建议采纳强正候选。"
        },
        {
          "assertion_ref": "EVD-I5B-LIYUAN-NEG-LIUWENJING-001@A2",
          "quote": "杀民部尚书、鲁国公刘文静。",
          "source": {
            "formal_v4_fact": false,
            "lineage_kind": "readonly_v3_regression_candidate",
            "locator": "高祖本纪，武德二年杀民部尚书鲁国公刘文静段",
            "source_ref": "SRC-JTS-J1-LIUWENJING-LIYUAN-001",
            "source_title": "旧唐书",
            "url": "https://zh.wikisource.org/zh-hans/舊唐書/卷1",
            "v3_card_blob": "7f00f0bc227807b385319dea3faab2fc638dbd39",
            "v3_freeze_tag": "v3-freeze-20260712",
            "v3_source_blob": "aee5cc390ad9c903b3b97e0e0edba516e66e5476"
          },
          "summary": "李渊杀早期关键谋臣刘文静，形成同一对象正负反转，可作为功臣安全强负候选。"
        }
      ],
      "ruler": "李渊",
      "subject": "刘文静",
      "unit_ref": "AD-G03"
    },
    {
      "context_kind": "rule_evidence_unit",
      "context_summary": "appointment_delegation 代表性缺口增补",
      "coverage_tags": [
        "conflicting_evidence"
      ],
      "evidence": [
        {
          "assertion_ref": "EVD-I5B-ZHAOGOU-POS-LIGANG-001@A1",
          "quote": "高宗即位，拜尚书右仆射兼中书侍郎……非相卿不可，卿其勿辞。",
          "source": {
            "formal_v4_fact": false,
            "lineage_kind": "readonly_v3_regression_candidate",
            "locator": "高宗即位拜李纲尚书右仆射段",
            "source_ref": "SRC-SS-J358-LIGANG-ZHAOGOU-001",
            "source_title": "宋史",
            "url": "https://zh.wikisource.org/wiki/宋史/卷358",
            "v3_card_blob": "7f00f0bc227807b385319dea3faab2fc638dbd39",
            "v3_freeze_tag": "v3-freeze-20260712",
            "v3_source_blob": "aee5cc390ad9c903b3b97e0e0edba516e66e5476"
          },
          "summary": "该段为第五项B识人拔擢正向候选，但后续去相需另证。"
        },
        {
          "assertion_ref": "AD-G04@A2",
          "quote": "張浚劾奏……詔罷李綱，其所規畫悉廢。",
          "source": {
            "formal_v4_fact": false,
            "lineage_kind": "human_frozen_primary_source_excerpt",
            "locator": "卷三百五十八，李纲传",
            "source_ref": "AD-G04@SRC2",
            "source_title": "宋史",
            "url": "https://zh.wikisource.org/wiki/宋史/卷358"
          },
          "summary": "赵构后撤销经制授权、罢免李纲并废其规划，形成同一授权弧的方向反转。"
        }
      ],
      "ruler": "赵构",
      "subject": "李纲",
      "unit_ref": "AD-G04"
    }
  ],
