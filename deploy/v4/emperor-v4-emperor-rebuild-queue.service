[Unit]
Description=Emperor Evaluation V4 unattended emperor rebuild queue
After=network-online.target emperor-v4-dynasty-governance-worker.service

[Service]
Type=oneshot
User=emperor-v4
Group=emperor-v4
WorkingDirectory=/opt/emperor-evaluation-v4/emperor-rebuild/current
EnvironmentFile=/etc/emperor-evaluation-v4/emperor-rebuild.env
Environment=PYTHONPATH=/opt/emperor-evaluation-v4/emperor-rebuild/current/src
Environment=PATH=/opt/emperor-evaluation-v4/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=CODEX_HOME=/data1/emperor-evaluation/runtime/services/emperor-v4/claim-extractor/codex
ExecStart=/opt/emperor-evaluation-v4/emperor-rebuild/venv/bin/python -m emperor_v4.runtime.emperor_rebuild_queue --release-root /opt/emperor-evaluation-v4/emperor-rebuild/current --state-root /data1/emperor-evaluation/runtime/services/emperor-v4/emperor-rebuild --source-index-root /data1/emperor-evaluation/runtime/active/source_text_indexes --dynasty-governance-root /data1/emperor-evaluation/runtime/active/dynasty_neutral_materials
TimeoutStartSec=31m
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data1/emperor-evaluation/runtime/services/emperor-v4/emperor-rebuild /data1/emperor-evaluation/runtime/services/emperor-v4/claim-extractor/codex
