[Unit]
Description=Emperor Evaluation V4 Source Cache lease worker
After=network-online.target

[Service]
Type=oneshot
User=emperor-v4
Group=emperor-v4
WorkingDirectory=/opt/emperor-evaluation-v4/source-cache/current
EnvironmentFile=/etc/emperor-evaluation-v4/source-cache.env
Environment=PYTHONPATH=/opt/emperor-evaluation-v4/source-cache/current/src
ExecStart=/opt/emperor-evaluation-v4/source-cache/venv/bin/python -m emperor_v4.runtime.source_cache_worker --worker-id %H-source-cache --provider wikisource --plan /etc/emperor-evaluation-v4/source-cache-plans --service-release-sha ${EMPEROR_EVAL_V4_RELEASE_SHA} --repo-root /opt/emperor-evaluation-v4/source-cache/current
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
