[Unit]
Description=Emperor Evaluation V4 Dynasty Governance neutral-material worker
After=network-online.target

[Service]
Type=oneshot
User=emperor-v4
Group=emperor-v4
WorkingDirectory=/opt/emperor-evaluation-v4/dynasty-governance/current
EnvironmentFile=/etc/emperor-evaluation-v4/dynasty-governance.env
Environment=PYTHONPATH=/opt/emperor-evaluation-v4/dynasty-governance/current/src
Environment=CODEX_HOME=/data1/emperor-evaluation/runtime/services/emperor-v4/claim-extractor/codex
RuntimeDirectory=emperor-v4-dynasty-governance
RuntimeDirectoryMode=0750
ExecStart=/opt/emperor-evaluation-v4/dynasty-governance/venv/bin/python -m emperor_v4.runtime.dynasty_governance_worker --source-index-root /data1/emperor-evaluation/runtime/active/source_text_indexes --runtime-root /data1/emperor-evaluation/runtime/active/dynasty_neutral_materials --workspace-root /opt/emperor-evaluation-v4/dynasty-governance/current --codex-bin ${EMPEROR_EVAL_V4_CODEX_BIN} --model-workers ${EMPEROR_EVAL_V4_DYNASTY_MODEL_WORKERS} --model-timeout-seconds ${EMPEROR_EVAL_V4_DYNASTY_MODEL_TIMEOUT_SECONDS} --target-chars ${EMPEROR_EVAL_V4_DYNASTY_TARGET_CHARS} --output /run/emperor-v4-dynasty-governance/last-tick.json
TimeoutStartSec=6h
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data1/emperor-evaluation/runtime/active/dynasty_neutral_materials /data1/emperor-evaluation/runtime/services/emperor-v4/claim-extractor/codex
