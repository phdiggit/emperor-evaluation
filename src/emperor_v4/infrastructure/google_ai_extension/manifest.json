{
  "manifest_version": 3,
  "name": "Emperor V4 Google AI Bridge",
  "version": "0.1.0",
  "description": "在专用 Google AI 标签页中串行执行本机 V4 宽搜任务。",
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
