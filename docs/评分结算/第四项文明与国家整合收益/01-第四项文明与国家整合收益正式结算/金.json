          "inherited_baseline": "non-rebel Khitan households retained community organization and Jurchen subjects retained broader voluntary choices over surnames, dress and cultural expression",
          "contemporary_feasible_frontier": "group identity could be supported through education and language institutions without forced dispersal or punitive restriction of personal cultural choices",
          "background_trend": "Khitan security concerns and Han-cultural attraction are background pressures; only coercive ruler-window responses are consumed",
          "attributable_change": "世宗明令禁止女真人改汉姓、仿南人衣装并设置刑责，以刑罚压缩姓名、服饰与文化选择。大定初对契丹猛安谋克曾有不分从乱与否的一概分隶，但《金史》同时记载世宗发现后明确纠正、令未从乱者仍旧，未闭合为持续实际损害，故从计分链剥离，只作为同一窗口自我纠偏反证。",
          "relative_change_level": "R2",
          "relative_change_level_basis": "GROUP_WIDE_PUNITIVE_RESTRICTION_OF_SURNAME_DRESS_AND_IDENTITY_CHOICES",
          "positive_component_level": null,
          "negative_component_level": "R2",
          "field_coverage": "Jurchen group-wide surname, dress and identity-expression choices",
          "access_expansion": null,
          "durability_and_handoff": "禁令明确进入世宗本纪并在本窗口施行；后继持续性未闭合，故停R2。",
          "cross_scene_replication": null,
          "attribution_strength": "JIN_SHIZONG_GOVERNMENT",
          "counterevidence": {
            "count": 1,
            "summary": "维护女真身份是政策目的，不构成独立参与改善；契丹一概分隶被世宗本人纠正，撤销其计分资格。只保留女真姓名服饰刑责N2，与独立放良P2同账为CIV0；轴级相抵不等于无损害。"
          },
