{
  "agents_budgets": {
    "AGENTS.md": {
      "max_bytes": 12288,
      "max_lines": 85
    },
    "scripts/AGENTS.md": {
      "max_bytes": 14336,
      "max_lines": 90
    }
  },
  "script_bloat_budgets": {
    "default_max_lines": 1000,
    "path_budgets": {
      "scripts/dev/i5b_factor_recalculator.py": {
        "max_lines": 1250,
        "reason": "I5B 因子重放仍承载明细回放、对象候选和结果写回，后续拆分前保留窄预算"
      },
      "scripts/dev/i5b_factor_table_sync.py": {
        "max_lines": 1100,
        "reason": "I5B 计分细则表同步与 calc_detail 审计暂在同一工具内，稳定后拆分共享 catalog 层"
      },
      "scripts/dev/i5b_query_profile_seed_builder.py": {
        "max_lines": 1250,
        "reason": "半成品 profile 种子候选与 source-discovery 仍在稳定语义，后续继续扩展前拆分 discovery/extractor 子模块"
      }
    }
  },
  "default_forbidden_patterns": [
    "exports/**",
    "data/**",
    "*.sqlite",
    "*.db"
  ],
