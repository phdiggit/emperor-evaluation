{
  "agents_budgets": {
    "AGENTS.md": {
      "max_bytes": 12288,
      "max_lines": 85
    },
    "scripts/AGENTS.md": {
      "max_bytes": 14336,
      "max_lines": 90
    }
  },
  "script_bloat_budgets": {
    "default_max_lines": 1000,
    "path_budgets": {
      "scripts/dev/i5b_factor_recalculator.py": {
        "max_lines": 1450,
        "reason": "I5B 因子重放暂含明细回放、对象候选、身份归一、已审非计分覆盖和结果写回，后续拆分前保留过渡预算"
      },
      "scripts/dev/i5b_factor_table_sync.py": {
        "max_lines": 1100,
        "reason": "I5B 计分细则表同步与 calc_detail 审计暂在同一工具内，稳定后拆分共享 catalog 层"
      },
      "scripts/dev/object_pool_importer.py": {
        "max_lines": 1100,
        "reason": "对象池导入器暂含 payload 解析、有限取值闸门、模板生成和写库冻结逻辑，后续拆分 schema/parser 层"
      },
      "scripts/dev/i5b_query_profile_seed_builder.py": {
        "max_lines": 1250,
        "reason": "半成品 profile 种子候选与 source-discovery 仍在稳定语义，后续继续扩展前拆分 discovery/extractor 子模块"
      },
      "scripts/dev/retrieval_v2_clean_runner.py": {
        "max_lines": 1150,
        "reason": "retrieval_v2 clean runner 暂承载 taskgen、候选切片、补源、判读分片和运行交接编排，质量/耗时优化稳定后拆分 orchestration 与阶段执行模块"
      },
      "scripts/dev/retrieval_v2_factorization_worklists.py": {
        "max_lines": 1250,
        "reason": "retrieval_v2 因子化派工、patch 验收、Codex 调度和日志恢复仍在联调期共用上下文，稳定后拆分 task runner 与 patch recovery 子模块"
      }
    }
  },
  "default_forbidden_patterns": [
    "exports/**",
    "data/**",
    "*.sqlite",
    "*.db"
  ],
